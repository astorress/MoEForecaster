# =============================================================================
# MoE Demand Forecasting: Makefile
# Usage: make <target>
#
# Docker targets need only Docker installed. The *-local targets use the active
# Python environment (conda or venv) with requirements.txt installed.
#
# Where artifacts are stored (data/, models/, results/):
#   default                          -> this repository
#   make pipeline OUTPUT_DIR=/path   -> /path on the host (Docker targets)
#   make pipeline-local OUTPUT_DIR=/path
# =============================================================================

.PHONY: help build up down pipeline benchmark nb pipeline-local benchmark-local nb-local clean

COMPOSE := docker compose

NOTEBOOKS := 01_data_acquisition 02_preprocessing 03_clustering 04_cluster_analysis_classifiers \
	05_expert_selection 06_gating_design 07_hpo 08_production_assembly

# Docker: OUTPUT_DIR is mounted at /output inside the container
ifdef OUTPUT_DIR
DOCKER_ENV := OUTPUT_DIR=$(abspath $(OUTPUT_DIR)) MOE_OUTPUT_ROOT=/output
LOCAL_ENV  := MOE_OUTPUT_ROOT=$(abspath $(OUTPUT_DIR))
endif

# Run a notebook with papermill and keep the executed copy in outputs/notebooks/
RUN_NB = $(DOCKER_ENV) $(COMPOSE) run --rm runner papermill --cwd /app/notebooks --log-output \
	/app/notebooks/$(1).ipynb /app/outputs/notebooks/$(1).ipynb
RUN_NB_LOCAL = $(LOCAL_ENV) papermill --cwd notebooks --log-output \
	notebooks/$(1).ipynb outputs/notebooks/$(1).ipynb

## help: Show this help
help:
	@echo "MoE Demand Forecasting - available commands:"
	@echo ""
	@grep -E '^## ' Makefile | sed 's/## /  make /'

## build: Build the Docker image with the pinned dependencies
build:
	@$(COMPOSE) build

## up: Start JupyterLab at http://localhost:8888 (Docker)
up:
	@$(DOCKER_ENV) $(COMPOSE) up -d --build --wait jupyter
	@echo "  [OK] JupyterLab at http://localhost:8888"

## down: Stop JupyterLab
down:
	@$(COMPOSE) down

## pipeline: Run notebooks 01 to 08 in order, from raw data to the production model (Docker)
pipeline:
	@mkdir -p outputs/notebooks
	@for nb in $(NOTEBOOKS); do \
		echo "==> $$nb"; \
		$(call RUN_NB,$$nb) || exit 1; \
	done
	@echo "  [OK] Production model in models/production/ (or OUTPUT_DIR/models/production/)"

## benchmark: Run notebook 09, MoE vs. baseline models (Docker; takes several hours on CPU)
benchmark:
	@mkdir -p outputs/notebooks
	@$(call RUN_NB,09_benchmark_comparison)

## nb: Run a single notebook, e.g. make nb NB=03_clustering (Docker)
nb:
	@test -n "$(NB)" || (echo "Usage: make nb NB=<notebook name without .ipynb>" && exit 1)
	@mkdir -p outputs/notebooks
	@$(call RUN_NB,$(NB))

## pipeline-local: Same as pipeline, in the active conda/venv environment
pipeline-local:
	@mkdir -p outputs/notebooks
	@for nb in $(NOTEBOOKS); do \
		echo "==> $$nb"; \
		$(call RUN_NB_LOCAL,$$nb) || exit 1; \
	done

## benchmark-local: Same as benchmark, in the active conda/venv environment
benchmark-local:
	@mkdir -p outputs/notebooks
	@$(call RUN_NB_LOCAL,09_benchmark_comparison)

## nb-local: Same as nb, in the active conda/venv environment
nb-local:
	@test -n "$(NB)" || (echo "Usage: make nb-local NB=<notebook name without .ipynb>" && exit 1)
	@mkdir -p outputs/notebooks
	@$(call RUN_NB_LOCAL,$(NB))

## clean: Delete data, models, results and executed notebooks in this repository (regenerated by make pipeline)
clean:
	@find data models results -type f ! -name '.gitignore' ! -name '.gitkeep' -delete
	@rm -rf outputs
	@echo "  [OK] Clean"
